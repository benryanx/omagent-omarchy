# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=omagent
OMAGENT_BIND_ADDRESS=127.0.0.1
OMAGENT_HTTP_PORT=8080
# Leave empty to use http://localhost:${OMAGENT_HTTP_PORT:-8080}.
OMAGENT_PUBLIC_URL=
# Leave empty to inherit OMAGENT_PUBLIC_URL.
OMAGENT_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set OMAGENT_PUBLIC_URL to https:// followed by the same hostname.
# Requires OMAGENT_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
OMAGENT_HTTPS_HOST=
OMAGENT_BASE_IMAGE=ghcr.io/benryanx/omagent-omarchy:latest
OMAGENT_LOCAL_IMAGE=omagent-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
OMAGENT_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
OMAGENT_DATA_EXTERNAL=false
